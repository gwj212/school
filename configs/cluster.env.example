# Copy to a private path on the cluster and edit values. Do not commit tokens.
MASTER_ADDR=10.0.0.10
MASTER_PORT=29500
NNODES=2
NODE_RANK=0
GPUS_PER_NODE=8

TRAIN_BACKEND=webdataset
WDS_ROOT=/shared/datasets/anysplat-inspired/webdataset/medium
TRAIN_WDS_CONFIG=/shared/code/vggt_large/configs/multi_dataset.yaml
WDS_NUM_WORKERS=2
WDS_PREFETCH_FACTOR=2
WDS_SHUFFLE_BUFFER=128
WDS_STEPS_PER_EPOCH=0

TEST_DIR=/shared/datasets/vggt_test
VGGT_MODEL=/shared/models/VGGT-1B
OUTPUT_DIR=/shared/outputs/vggt_cluster_run01
MAX_IMG_SIDE=448
TRAIN_VIEWS_PER_STEP=5
STEP_BUDGET_MODE=updates
RESUME=
